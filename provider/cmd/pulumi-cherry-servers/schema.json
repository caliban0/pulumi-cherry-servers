        },
        "team": {
          "type": "integer",
          "description": "ID of the team the project belongs to."
        }
      },
      "requiredInputs": [
        "team"
      ]
    },
    "pulumi-cherry-servers:provider:Server": {
      "description": "Cherry Servers server instance.",
      "properties": {
        "allowReinstall": {
          "type": "boolean",
          "description": "Whether re-installation is permitted for this server."
        },
        "bgp": {
          "type": "boolean",
          "description": "Whether BGP is enabled for the server."
        },
        "blockStorage": {
          "type": "integer",
          "description": "Server elastic block storage ID."
        },
        "cycle": {
          "type": "string",
          "description": "Server billing cycle."
        },
        "discountCode": {
          "type": "string",
          "description": "Server discount code."
        },
        "extraIPs": {
          "type": "array",
