          "type": "string",
          "description": "Reverse DNS name for the IP address."
        },
        "region": {
          "type": "string",
          "description": "IP address project ID."
        },
        "routedTo": {
          "type": "string",
          "description": "IP address that this address is routed to."
        },
        "tags": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "IP address tags."
        },
        "targetedTo": {
          "type": "integer",
          "description": "Server that this address is targeted to."
        },
        "type": {
          "type": "string",
          "description": "IP address type."
        }
      },
      "required": [
        "region",
        "project",
        "address",
        "addressFamily",
        "cidr",
        "type",
