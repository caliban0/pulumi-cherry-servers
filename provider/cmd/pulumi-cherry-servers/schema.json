        "ptrRecordEffective"
      ],
      "inputProperties": {
        "aRecord": {
          "type": "string",
          "description": "Relative DNS name for the IP address.Resulting FQDN will be '<relative-dns-name>.cloud.cherryservers.net' and must be globally unique. The value will be stored in `aRecordEffective`"
        },
        "project": {
          "type": "integer"
        },
        "ptrRecord": {
          "type": "string",
          "description": "Reverse DNS name for the IP address.The value will be stored in `ptrRecordEffective`"
