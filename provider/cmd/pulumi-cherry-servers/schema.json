        },
        "aRecordEffective": {
          "type": "string",
          "description": "Relative DNS name for the IP address."
        },
        "address": {
          "type": "string",
          "description": "Actual address."
        },
        "addressFamily": {
          "type": "integer",
          "description": "IP address family."
        },
        "cidr": {
          "type": "string",
          "description": "IP address CIDR."
        },
        "project": {
          "type": "integer"
        },
        "ptrRecord": {
          "type": "string",
          "description": "Reverse DNS name for the IP address.The value will be stored in `ptrRecordEffective`"
        },
