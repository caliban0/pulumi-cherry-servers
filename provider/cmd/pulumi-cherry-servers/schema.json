  "config": {
    "variables": {
      "token": {
        "type": "string",
        "description": "Cherry Servers API token.",
        "secret": true
      }
    },
    "defaults": [
      "token"
    ]
  },
  "types": {
    "pulumi-cherry-servers:provider:ServerIPState": {
      "properties": {
        "address": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "type": "object",
      "required": [
        "id",
        "type",
        "address"
      ]
    },
    "pulumi-cherry-servers:provider:ServerPricingState": {
      "properties": {
        "currency": {
          "type": "string"
        },
        "price": {
          "type": "number"
